# ----- REQUIRED -----
NEXT_PUBLIC_SITE_URL=https://workflowkits.com
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxx
JWT_SECRET=please-change-me

# Private durable storage for website accounts. Set in hosting settings, never commit a real URL.
ACCOUNT_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Public Google OAuth Web Client ID. Google must authorise https://workflowkits.com.
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# (Optional) Useful in local dev:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
